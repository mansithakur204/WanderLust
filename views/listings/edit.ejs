<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-8 col-lg-7 mx-auto">
    <h3 class="fw-bold mb-4">Edit your listing</h3>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          id="title"
          value="<%= listing.title %>"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please provide a title</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          name="listing[description]"
          id="description"
          rows="4"
          class="form-control"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <% if ((listing.images && listing.images.length > 0) || originalImageUrl) { %>
        <div class="mb-3">
          <label class="form-label d-block">Existing Images</label>
          <div class="d-flex flex-wrap gap-2">
            <% if (listing.images && listing.images.length > 0) { %>
              <% for(let img of listing.images) { %>
                <img src="<%= img.url.replace('/upload', '/upload/w_200') %>" class="img-thumbnail rounded" style="height: 100px; width: 120px; object-fit: cover;" alt="Listing image">
              <% } %>
            <% } else if (originalImageUrl) { %>
              <img src="<%= originalImageUrl %>" class="img-thumbnail rounded" style="height: 100px; width: 120px; object-fit: cover;" alt="Listing image">
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="mb-3">
        <label for="images" class="form-label">Upload Additional Images (Optional)</label>
        <input
          name="listing[images]"
          id="images"
          type="file"
          class="form-control"
          multiple
        />
      </div>

      <div class="row">
        <%
          const allCategories = [
            "Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", 
            "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Boats", "Beach"
          ];
          const propertyTypes = ["Villa", "House", "Apartment", "Cabin", "Cottage", "Hotel", "Guesthouse"];
        %>
        <div class="mb-3 col-12 col-sm-6">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" id="category" class="form-select" required>
            <% for(let catOption of allCategories) { %>
              <option value="<%= catOption %>" <%= listing.category === catOption ? 'selected' : '' %>><%= catOption %></option>
            <% } %>
          </select>
        </div>

        <div class="mb-3 col-12 col-sm-6">
          <label for="propertyType" class="form-label">Property Type</label>
          <select name="listing[propertyType]" id="propertyType" class="form-select" required>
            <% for(let pType of propertyTypes) { %>
              <option value="<%= pType %>" <%= listing.propertyType === pType ? 'selected' : '' %>><%= pType %></option>
            <% } %>
          </select>
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-6 col-sm-3">
          <label for="maxGuests" class="form-label">Guests</label>
          <input name="listing[maxGuests]" id="maxGuests" type="number" min="1" value="<%= listing.maxGuests || 4 %>" class="form-control" required />
        </div>
        <div class="mb-3 col-6 col-sm-3">
          <label for="bedrooms" class="form-label">Bedrooms</label>
          <input name="listing[bedrooms]" id="bedrooms" type="number" min="0" value="<%= listing.bedrooms || 2 %>" class="form-control" required />
        </div>
        <div class="mb-3 col-6 col-sm-3">
          <label for="beds" class="form-label">Beds</label>
          <input name="listing[beds]" id="beds" type="number" min="0" value="<%= listing.beds || 2 %>" class="form-control" required />
        </div>
        <div class="mb-3 col-6 col-sm-3">
          <label for="bathrooms" class="form-label">Baths</label>
          <input name="listing[bathrooms]" id="bathrooms" type="number" min="0" value="<%= listing.bathrooms || 1 %>" class="form-control" required />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label d-block">Amenities</label>
        <div class="row g-2">
          <% 
            const allAmenities = [
              { name: "WiFi", icon: "fa-wifi" },
              { name: "Kitchen", icon: "fa-kitchen-set" },
              { name: "Air Conditioning", icon: "fa-snowflake" },
              { name: "Free Parking", icon: "fa-square-parking" },
              { name: "Pool", icon: "fa-person-swimming" },
              { name: "Workspace", icon: "fa-laptop" },
              { name: "TV", icon: "fa-tv" },
              { name: "Washing Machine", icon: "fa-shirt" },
              { name: "Heating", icon: "fa-temperature-arrow-up" },
              { name: "Balcony", icon: "fa-mountain-sun" }
            ];
            const currentAmenities = listing.amenities || [];
          %>
          <% for(let amenity of allAmenities) { %>
            <div class="col-6 col-sm-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="listing[amenities][]" value="<%= amenity.name %>" id="amenity_edit_<%= amenity.name %>" <%= currentAmenities.includes(amenity.name) ? 'checked' : '' %>>
                <label class="form-check-label" for="amenity_edit_<%= amenity.name %>">
                  <i class="fa-solid <%= amenity.icon %> me-1 text-secondary"></i> <%= amenity.name %>
                </label>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-12 col-sm-4">
          <label for="price" class="form-label">Price (&#8377;)</label>
          <input
            name="listing[price]"
            id="price"
            value="<%= listing.price %>"
            type="number"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Price should be valid</div>
        </div>

        <div class="mb-3 col-12 col-sm-8">
          <label for="country" class="form-label">Country</label>
          <input
            name="listing[country]"
            id="country"
            value="<%= listing.country %>"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country name should be valid</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          name="listing[location]"
          id="location"
          value="<%= listing.location %>"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <button class="btn edit-btn w-100 mt-3 py-2 fs-6">Update Listing</button>
    </form>
  </div>
</div>


