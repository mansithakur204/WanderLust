<% layout("/layouts/boilerplate") %>

<%
  const categoriesList = [
    { name: "Trending", icon: "fa-solid fa-fire" },
    { name: "Rooms", icon: "fa-solid fa-bed" },
    { name: "Iconic Cities", icon: "fa-solid fa-mountain-city" },
    { name: "Mountains", icon: "fa-solid fa-mountain" },
    { name: "Castles", icon: "fa-brands fa-fort-awesome" },
    { name: "Amazing Pools", icon: "fa-solid fa-person-swimming" },
    { name: "Camping", icon: "fa-solid fa-campground" },
    { name: "Farms", icon: "fa-solid fa-cow" },
    { name: "Arctic", icon: "fa-regular fa-snowflake" },
    { name: "Domes", icon: "fa-solid fa-igloo" },
    { name: "Boats", icon: "fa-solid fa-ship" },
    { name: "Beach", icon: "fa-solid fa-umbrella-beach" },
  ];
%>

<div id="filters" class="d-flex align-items-center justify-content-between flex-wrap gap-3">
  <div class="filter-container">
    <% for(let cat of categoriesList) { %>
      <% 
        let isActive = (category && category.toLowerCase() === cat.name.toLowerCase());
        let catQuery = new URLSearchParams();
        if(!isActive) {
          catQuery.set("category", cat.name);
        }
        if(search) { catQuery.set("search", search); }
        if(sort) { catQuery.set("sort", sort); }
        let catUrl = "/listings" + (catQuery.toString() ? "?" + catQuery.toString() : "");
      %>
      <a href="<%= catUrl %>" class="filter-link text-decoration-none">
        <div class="filter <%= isActive ? 'active' : '' %>">
          <div><i class="<%= cat.icon %>"></i></div>
          <p><%= cat.name %></p>
        </div>
      </a>
    <% } %>
  </div>

  <div class="d-flex align-items-center gap-3 ms-auto">
    <!-- Sort Control -->
    <div class="sort-dropdown">
      <select class="form-select form-select-sm shadow-sm" id="sortSelect" onchange="applySort(this.value)" aria-label="Sort listings">
        <option value="" <%= !sort ? 'selected' : '' %>>Sort by: Default</option>
        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
      </select>
    </div>

    <!-- Tax Toggle -->
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label ms-2" for="switchCheckDefault">Display total after taxes</label>
      </div>
    </div>
  </div>
</div>

<!-- Active Filter Bar -->
<% if(search || category || sort) { %>
  <div class="d-flex align-items-center flex-wrap gap-2 my-3 p-2 bg-light rounded border">
    <span class="text-muted small fw-bold me-1">Active Filters:</span>
    <% if(search) { %>
      <span class="badge bg-secondary">Search: "<%= search %>"</span>
    <% } %>
    <% if(category) { %>
      <span class="badge bg-danger">Category: <%= category %></span>
    <% } %>
    <% if(sort) { %>
      <span class="badge bg-dark">
        Sort: <%= sort === 'price_asc' ? 'Price: Low to High' : (sort === 'price_desc' ? 'Price: High to Low' : sort) %>
      </span>
    <% } %>
    <a href="/listings" class="btn btn-sm btn-outline-secondary ms-auto text-decoration-none py-0 fs-7">
      <i class="fa-solid fa-xmark me-1"></i>Clear all filters
    </a>
  </div>
<% } %>

<!-- Listings Grid / Empty State -->
<% if(allListings && allListings.length > 0) { %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mt-1">
    <% for(let listing of allListings){ %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card listing-card h-100">
            <div class="card-img-wrapper">
              <img src="<%= (listing.images && listing.images.length > 0) ? listing.images[0].url : (listing.image ? listing.image.url : '') %>" class="card-img-top" alt="<%= listing.title %>">
              <% if(listing.category) { %>
                <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75"><%= listing.category %></span>
              <% } %>
              <% let isSavedCard = typeof savedListingIds !== 'undefined' && savedListingIds.has(listing._id.toString()); %>
              <button 
                class="fav-btn btn position-absolute top-0 end-0 m-2 p-1 border-0 shadow-none" 
                title="<%= isSavedCard ? 'Remove from wishlist' : 'Add to wishlist' %>" 
                aria-label="<%= isSavedCard ? 'Remove from wishlist' : 'Add to wishlist' %>" 
                onclick="toggleWishlist(event, '<%= listing._id %>')"
              >
                <i class="<%= isSavedCard ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart text-white' %> fs-5"></i>
              </button>
            </div>


            <div class="card-body">
              <h5 class="card-title-text"><%= listing.title %></h5>
              <p class="card-price-text mb-0">
                <b>&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></b> / night
                <span class="tax-info"> &nbsp;+18% GST</span>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } else { %>
  <div class="text-center py-5 my-5 bg-light rounded border">
    <i class="fa-solid fa-magnifying-glass-location text-muted display-3 mb-3"></i>
    <h3 class="fw-bold">No listings found</h3>
    <p class="text-secondary mb-4">
      We couldn't find any listings matching your search or selected filters.<br>
      Try checking your spelling or clear your filters to explore all listings.
    </p>
    <a href="/listings" class="btn btn-dark px-4 py-2">Clear all filters</a>
  </div>
<% } %>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  if(taxSwitch) {
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for(let info of taxInfo){
        if(info.style.display !== "inline"){
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });
  }

  function applySort(sortVal) {
    const urlParams = new URLSearchParams(window.location.search);
    if(sortVal) {
      urlParams.set("sort", sortVal);
    } else {
      urlParams.delete("sort");
    }
    window.location.href = "/listings" + (urlParams.toString() ? "?" + urlParams.toString() : "");
  }
</script>


