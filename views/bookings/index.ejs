<% layout("/layouts/boilerplate") %>

<div class="container py-4 py-md-5">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-suitcase text-danger me-2"></i>My Trips</h2>
      <p class="text-muted small mb-0">Manage your past and upcoming reservations on WanderLust.</p>
    </div>
    <a href="/listings" class="btn btn-outline-dark rounded-pill px-3.5 py-1.5 fw-semibold small">
      <i class="fa-solid fa-magnifying-glass me-1"></i>Explore More Listings
    </a>
  </div>

  <% if (!bookings || bookings.length === 0) { %>
    <!-- Empty State -->
    <div class="text-center py-5 my-4 bg-white rounded-4 border p-4">
      <div class="mb-3 text-secondary opacity-50">
        <i class="fa-solid fa-plane-slash fa-4x"></i>
      </div>
      <h4 class="fw-bold text-dark mb-2">No trips yet</h4>
      <p class="text-muted mb-4 mx-auto" style="max-width: 400px;">
        When you're ready to start planning your next getaway, we're here to help you find your dream stay.
      </p>
      <a href="/listings" class="btn add-btn px-4 py-2 rounded-3 fw-semibold shadow-sm">
        Explore listings
      </a>
    </div>
  <% } else { %>
    <!-- Bookings Cards Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% for (let booking of bookings) { %>
        <%
          let coverImage = "https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=80";
          if (booking.listing && booking.listing.images && booking.listing.images.length > 0) {
            coverImage = booking.listing.images[0].url;
          } else if (booking.listing && booking.listing.image && booking.listing.image.url) {
            coverImage = booking.listing.image.url;
          }
        %>
        <div class="col">
          <div class="card h-100 border shadow-sm rounded-4 overflow-hidden position-relative">
            <div class="position-relative" style="height: 180px;">
              <img src="<%= coverImage %>" class="w-100 h-100 object-fit-cover" alt="<%= booking.listing ? booking.listing.title : 'Listing' %>">
              <span class="position-absolute top-0 end-0 m-3 badge rounded-pill <%= booking.status === 'confirmed' ? 'bg-success' : 'bg-secondary' %> px-3 py-1.5 fw-semibold text-capitalize shadow-sm">
                <%= booking.status %>
              </span>
            </div>

            <div class="card-body d-flex flex-column p-3">
              <% if (booking.listing) { %>
                <h5 class="card-title fw-bold text-dark text-truncate mb-1"><%= booking.listing.title %></h5>
                <p class="text-muted small mb-2 text-truncate">
                  <i class="fa-solid fa-location-dot text-danger me-1"></i><%= booking.listing.location %>, <%= booking.listing.country %>
                </p>
              <% } else { %>
                <h5 class="card-title fw-bold text-dark mb-1">Listing Unavailable</h5>
              <% } %>

              <div class="bg-body-tertiary rounded-3 p-2.5 mb-3 small">
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted">Dates:</span>
                  <span class="fw-semibold text-dark">
                    <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %> - <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted">Guests:</span>
                  <span class="fw-semibold text-dark"><%= booking.guests %> <%= booking.guests === 1 ? 'guest' : 'guests' %> (<%= booking.nights %> <%= booking.nights === 1 ? 'night' : 'nights' %>)</span>
                </div>
                <div class="d-flex justify-content-between pt-1 border-top">
                  <span class="text-muted">Total:</span>
                  <span class="fw-bold text-danger">&#8377;<%= booking.totalPrice ? booking.totalPrice.toLocaleString('en-IN') : '0' %></span>
                </div>
              </div>

              <div class="mt-auto d-flex gap-2">
                <a href="/bookings/<%= booking._id %>" class="btn btn-outline-dark btn-sm flex-grow-1 rounded-3 fw-semibold py-1.5">
                  View Details
                </a>
                <% if (booking.status === 'confirmed') { %>
                  <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                    <button class="btn btn-outline-danger btn-sm rounded-3 fw-semibold py-1.5 px-3">
                      Cancel
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
