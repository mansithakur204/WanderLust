<% layout("/layouts/boilerplate") %>

<div class="container py-4 py-md-5">
  <div class="mx-auto" style="max-width: 440px;">
    <!-- Forgot Password Card Container -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-4 bg-white">
      <div class="text-center mb-4">
        <div class="mb-3 text-danger">
          <i class="fa-solid fa-key fa-2x"></i>
        </div>
        <h2 class="fw-bold fs-3 text-dark mb-2">Forgot Password?</h2>
        <p class="text-muted small mb-0">Enter your registered email or username below and we'll send you a password reset link.</p>
      </div>

      <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
        <div class="mb-4">
          <label for="credential" class="form-label fw-semibold text-dark small mb-1">Username or Email</label>
          <input
            name="credential"
            id="credential"
            type="text"
            class="form-control rounded-3 py-2 px-3 fs-6"
            placeholder="Enter your username or email"
            required
          />
          <div class="invalid-feedback">Please enter your username or email address</div>
        </div>

        <button class="btn add-btn w-100 py-2.5 rounded-3 fw-semibold shadow-sm fs-6 mt-1">Send Reset Link</button>
      </form>

      <div class="text-center mt-4 pt-2 border-top">
        <p class="small text-muted mb-0">Remembered your password? <a href="/login" class="text-danger fw-semibold text-decoration-none">Log in</a></p>
      </div>
    </div>
  </div>
</div>
