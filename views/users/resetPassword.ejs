<% layout("/layouts/boilerplate") %>

<div class="container py-4 py-md-5">
  <div class="mx-auto" style="max-width: 440px;">
    <!-- Reset Password Card Container -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-4 bg-white">
      <div class="text-center mb-4">
        <div class="mb-3 text-danger">
          <i class="fa-solid fa-lock fa-2x"></i>
        </div>
        <h2 class="fw-bold fs-3 text-dark mb-2">Reset Password</h2>
        <p class="text-muted small mb-0">Please create a new strong password for your WanderLust account.</p>
      </div>

      <form action="/reset-password/<%= token %>" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="password" class="form-label fw-semibold text-dark small mb-1">New Password</label>
          <input
            name="password"
            id="password"
            type="password"
            class="form-control rounded-3 py-2 px-3 fs-6"
            placeholder="Create a strong new password"
            required
          />
          <div class="invalid-feedback">Please enter a new password</div>

          <!-- Password Feedback Wrapper (Hidden initially, revealed when user types) -->
          <div id="passwordFeedback" class="d-none">
            <!-- Password Strength Meter -->
            <div id="strengthContainer" class="mt-2">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="small text-muted fw-medium" style="font-size: 0.75rem;">Password strength</span>
                <span id="strengthText" class="small fw-bold" style="font-size: 0.75rem;"></span>
              </div>
              <div class="progress rounded-pill bg-light" style="height: 5px;">
                <div id="strengthBar" class="progress-bar rounded-pill transition-all" role="progressbar" style="width: 0%; transition: width 0.3s ease;"></div>
              </div>
            </div>

            <!-- Password Requirements Checklist -->
            <div class="p-3 mt-3 bg-body-tertiary rounded-3 border-0">
              <div class="fw-semibold text-secondary small mb-2" style="font-size: 0.8rem;">Password requirements</div>
              <div class="row row-cols-1 row-cols-sm-2 g-2 small" id="passwordRequirements" style="font-size: 0.8rem;">
                <div class="col text-muted" id="req-length"><i class="fa-regular fa-circle me-1 small opacity-50"></i>8+ characters</div>
                <div class="col text-muted" id="req-upper"><i class="fa-regular fa-circle me-1 small opacity-50"></i>Uppercase letter</div>
                <div class="col text-muted" id="req-lower"><i class="fa-regular fa-circle me-1 small opacity-50"></i>Lowercase letter</div>
                <div class="col text-muted" id="req-number"><i class="fa-regular fa-circle me-1 small opacity-50"></i>Number</div>
                <div class="col text-muted col-sm-12" id="req-special"><i class="fa-regular fa-circle me-1 small opacity-50"></i>Special character</div>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <label for="confirmPassword" class="form-label fw-semibold text-dark small mb-1">Confirm New Password</label>
          <input
            name="confirmPassword"
            id="confirmPassword"
            type="password"
            class="form-control rounded-3 py-2 px-3 fs-6"
            placeholder="Re-enter your new password"
            required
          />
          <div id="matchText" class="form-text"></div>
          <div class="invalid-feedback">Please confirm your new password</div>
        </div>

        <button class="btn add-btn w-100 py-2.5 rounded-3 fw-semibold shadow-sm fs-6 mt-1">Reset Password</button>
      </form>
    </div>
  </div>
</div>

<script src="/js/passwordStrength.js"></script>
