<% layout("/layouts/boilerplate") %>

<div class="container py-4 py-md-5">
  <div class="mx-auto" style="max-width: 440px;">
    <!-- Login Card Container -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-4 bg-white">
      <div class="text-center mb-4">
        <h2 class="fw-bold fs-3 text-dark mb-2">Login to WanderLust</h2>
        <p class="text-muted small mb-0">Welcome back! Please enter your details.</p>
      </div>

      <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold text-dark small mb-1">Username</label>
          <input
            name="username"
            id="username"
            type="text"
            class="form-control rounded-3 py-2 px-3 fs-6"
            placeholder="Enter username"
            required
          />
          <div class="invalid-feedback">Please enter your username</div>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="password" class="form-label fw-semibold text-dark small mb-0">Password</label>
            <a href="/forgot-password" class="small text-danger text-decoration-none fw-semibold">Forgot password?</a>
          </div>
          <input
            name="password"
            id="password"
            type="password"
            class="form-control rounded-3 py-2 px-3 fs-6"
            placeholder="Enter password"
            required
          />
          <div class="invalid-feedback">Please enter your password</div>
        </div>

        <button class="btn add-btn w-100 py-2.5 rounded-3 fw-semibold shadow-sm fs-6 mt-2">Login</button>
      </form>

      <div class="text-center mt-4 pt-2 border-top">
        <p class="small text-muted mb-0">Don't have an account? <a href="/signup" class="text-danger fw-semibold text-decoration-none">Sign up</a></p>
      </div>
    </div>
  </div>
</div>


